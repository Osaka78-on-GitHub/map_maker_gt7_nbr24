#!/bin/bash
awk -F'|' '
{
  n = NF - 2
  is_sep = 1
  for (i = 2; i <= n+1; i++) {
    gsub(/^[ \t]+|[ \t]+$/, "", $i)
    if ($i !~ /^:?-+:?$/) is_sep = 0
  }
  for (i = 2; i <= n+1; i++) {
    cols[NR, i-1] = $i
    if (!is_sep) {
      w = length($i)
      if (w > width[i-1]) width[i-1] = w
    }
  }
  if (NR == 1) ncols = n
  sep[NR] = is_sep
}
END {
  for (r = 1; r <= NR; r++) {
    printf "|"
    for (c = 1; c <= ncols; c++) {
      if (sep[r]) {
        s = ""
        for (i = 0; i < width[c]; i++) s = s "-"
        printf " %s |", s
      } else {
        printf " %-*s |", width[c], cols[r,c]
      }
    }
    printf "\n"
  }
}' awk_in > awk_out
