#!/bin/bash
: << EOF
Resize a md table with awk and bash 
so it looks good in plain text

awk_in  copy paste your crappy table here
awk_out get your nice table here

Made with the assistance of Ask Brave
EOF

# 1. awk measures raw widths (skipping separator rows)
awk -F'|' '
{
  n = NF - 2
  is_sep = 1
  for (i = 2; i <= n+1; i++) {
    gsub(/^[ \t]+|[ \t]+$/, "", $i)
    if ($i !~ /^:?-+:?$/) is_sep = 0
  }
  for (i = 2; i <= n+1; i++) {
    if (!is_sep && length($i) > width[i-1]) width[i-1] = length($i)
  }
  if (NR == 1) ncols = n
}
END {
  for (c = 1; c <= ncols; c++) printf "%d ", width[c]
  print ""
}' awk_in > /tmp/awk_md_widths

# 2. bash reads widths
read -ra widths < /tmp/awk_md_widths

# 3. awk formats with measured widths
awk -F'|' -v widths="$(printf '%s ' "${widths[@]}")" '
BEGIN {
  split(widths, w, " ")
}
{
  n = NF - 2
  is_sep = 1
  for (i = 2; i <= n+1; i++) {
    gsub(/^[ \t]+|[ \t]+$/, "", $i)
    if ($i !~ /^:?-+:?$/) is_sep = 0
  }
  printf "|"
  for (i = 2; i <= n+1; i++) {
    c = i - 1
    if (is_sep) {
      s = ""
      for (j = 0; j < w[c]; j++) s = s "-"
      printf " %s |", s
    } else {
      printf " %-*s |", w[c], $i
    }
  }
  printf "\n"
}' awk_in > awk_out   
