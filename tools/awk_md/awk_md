#!/bin/bash
: << EOF
Use awk and bash to make a nice md table
that looks good in plain text

awk_md_in  copy paste your crappy table here
awk_md_out get your nice table here

Made with the assistance of Ask Brave
EOF
# 1. awk measures raw widths
read w1 w2 < <(awk '{
  if(length($1)>a) a=length($1)
  if(length($2)>b) b=length($2)
} END{print a, b}' awk_in)

# 2. bash snaps them
snap_fibonacci() {
f=$1
[[ $f -lt 5 ]] && f=5 && return
[[ $f -lt 8 ]] && f=8 && return
[[ $f -lt 13 ]] && f=13 && return
[[ $f -lt 21 ]] && f=21 && return
[[ $f -lt 34 ]] && f=34 && return
[[ $f -lt 55 ]] && f=55 && return
[[ $f -lt 89 ]] && f=89 && return
[[ $f -lt 144 ]] && f=144 && return
[[ $f -lt 233 ]] && f=233 && return
}
snap_fibonacci $w1 && w1=$f
snap_fibonacci $w2 && w2=$f

# 3. awk formats with snapped widths
awk -v w1=$w1 -v w2=$w2 '
FNR==1 {
  printf "| %-*s | %-*s |\n", w1, $1, w2, $2
  s1=""; for(i=0;i<=w1;i++) s1=s1"-"
  s2=""; for(i=0;i<=w2;i++) s2=s2"-"
  printf "|:%s|:%s|\n", s1, s2
  next
}
{
  printf "| %-*s | %-*s |\n", w1, $1, w2, $2
}' awk_md_in > awk_md_out
